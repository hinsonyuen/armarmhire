DATABASE_URL="postgresql://armarmhire_user:armarmhire_pass@localhost:5433/armarmhire?schema=public"

# Outgoing email (recruiter sign-up links). The defaults point at the
# Mailpit container from docker-compose.yml: open http://localhost:8025
# to read the emails. For real delivery, use your provider's SMTP
# settings (e.g. SendGrid, Postmark, Gmail app password) instead.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ArmArmHire <no-reply@armarmhire.local>"
# Base URL used in emailed links. Leave unset locally; set it to the
# public URL (e.g. https://app.armarmhire.com) when deployed.
# APP_URL="http://localhost:3000"
